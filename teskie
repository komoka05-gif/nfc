<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Wiadomość</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #000;
      color: #fff;
      font-family: system-ui, -apple-system, sans-serif;
      font-size: clamp(1.5rem, 6vw, 3.5rem);
      text-align: center;
      padding: 24px;
      box-sizing: border-box;
    }
  </style>
</head>
<body>
  <div id="txt"></div>
  <script>
    const params = new URLSearchParams(window.location.search);
    document.getElementById('txt').textContent = params.get('t') || 'Brak tekstu';
  </script>
</body>
</html>
